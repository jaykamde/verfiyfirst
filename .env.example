# --- AI (required for live checks; without it the app runs in clearly-labelled DEMO mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Database (Supabase). Without these the app uses a local JSON file (dev only) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Automation (n8n webhook URL + the shared secret you set in n8n Header Auth) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Dashboard ---
ADMIN_KEY=change-me

# --- Cost guards ---
MAX_DAILY_AGENT_RUNS=150
